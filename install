#!/usr/bin/env python3
"""Install and verify this checkout in the current Codex configuration."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory


def main() -> None:
    checkout = Path(__file__).resolve().parent
    if sys.version_info < (3, 10):
        sys.exit("Use Python 3.10 or newer to run ./install.")
    parser = argparse.ArgumentParser(
        description="Register this checkout as a Codex marketplace and install the selected plugins.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Requirements:
  parallel-review   Signed-in Codex CLI with access to the reviewer model.
  scope-check       By default, export JEV_API_KEY or create the macOS login
                    Keychain password item codex-work-hooks.jev.

Upgrading from the combined work-hooks plugin?
  Run codex plugin remove work-hooks@work-hooks before installing its replacement.

After installation, open a new Codex session and review the hooks in /hooks.
See README.md for credential setup and daemon troubleshooting.""",
    )
    parser.add_argument("plugin", choices=("scope-check", "parallel-review", "both"), nargs="?", default="both",
                        help="plugin selection (default: both)")
    choice = parser.parse_args().plugin
    names = ("scope-check", "parallel-review") if choice == "both" else (choice,)

    home = Path(os.getenv("CODEX_HOME") or Path.home() / ".codex")
    legacy = home / "plugins/cache/work-hooks/work-hooks"
    if legacy.is_dir() and any(legacy.glob("*/.codex-plugin/plugin.json")):
        sys.exit("The combined Work Hooks plugin is still cached. Run "
                 "codex plugin remove work-hooks@work-hooks, then rerun this installer.")

    if "scope-check" in names:
        # Check credentials and connectivity before enabling a hook that gates every prompt.
        _probe_scope(checkout / "src/scope-check")
    if "parallel-review" in names:
        subprocess.run(["codex", "login", "status"], check=True)

    _register_marketplace(checkout)
    for name in names:
        installed = _install_plugin(checkout, name)
        print(f"Ready: {name} at {installed}")


def _install_plugin(checkout: Path, name: str) -> Path:
    result = subprocess.check_output(["codex", "plugin", "add", f"{name}@work-hooks", "--json"])
    installed = Path(json.loads(result)["installedPath"])
    package = checkout / "src" / name
    for source in package.rglob("*"):
        if source.is_file() and "__pycache__" not in source.parts:
            copied = installed / source.relative_to(package)
            if not copied.is_file() or copied.read_bytes() != source.read_bytes():
                sys.exit(f"Installed plugin differs from checkout at {source.relative_to(package)}.")
    return installed


def _probe_scope(installed: Path) -> None:
    with TemporaryDirectory() as workspace:
        event = dict(hook_event_name="UserPromptSubmit", session_id="installation-check",
                     cwd=workspace, prompt="Build a banana game for my own amusement.")
        response = subprocess.check_output(
            [sys.executable, installed / "hooks/dispatch.py"], text=True, input=json.dumps(event),
            cwd=workspace, env={**os.environ, "PLUGIN_DATA": workspace, "PLUGIN_ROOT": str(installed)},
        )
        decision = json.loads(response)
        if decision != {}:
            sys.exit(decision.get("reason", "The personal test request was not approved."))
    print("Scope classifier approved a test submission from the installation shell.")


def _register_marketplace(checkout: Path) -> None:
    add = ["codex", "plugin", "marketplace", "add", str(checkout)]
    result = subprocess.run(add, stderr=subprocess.PIPE, text=True)
    if result.returncode == 0:
        return

    conflict = "marketplace 'work-hooks' is already added from a different source"
    if conflict not in result.stderr:
        sys.exit(result.stderr.strip() or "Codex could not register the work-hooks marketplace.")

    print(f"Updating the work-hooks marketplace source to {checkout}.", flush=True)
    subprocess.run(["codex", "plugin", "marketplace", "remove", "work-hooks"], check=True)
    subprocess.run(add, check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(f"{error.cmd[0]} exited with status {error.returncode}.")
