#!/usr/bin/env python3
"""Install and verify this checkout in the current Codex configuration."""
import json
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory


def main() -> None:
    checkout = Path(__file__).resolve().parent
    if sys.version_info < (3, 10):
        sys.exit("Use Python 3.10 or newer to run ./install.")
    if os.environ.get("WORK_HOOKS_CLASSIFIER", "jev") != "jev":
        sys.exit("Unset WORK_HOOKS_CLASSIFIER to select the default Jev classifier.")
    if not os.environ.get("JEV_API_KEY"):
        sys.exit("Export JEV_API_KEY in the shell that launches Codex, then rerun ./install.")

    subprocess.run(["codex", "plugin", "marketplace", "add", str(checkout)], check=True)
    result = subprocess.check_output(["codex", "plugin", "add", "work-hooks@work-hooks", "--json"])
    installed = Path(json.loads(result)["installedPath"])
    for directory in (".codex-plugin", "hooks", "src"):
        for source in (checkout / directory).rglob("*"):
            if source.is_file() and "__pycache__" not in source.parts:
                copied = installed / source.relative_to(checkout)
                if not copied.is_file() or copied.read_bytes() != source.read_bytes():
                    sys.exit(f"Installed plugin differs from this checkout at {source.relative_to(checkout)}.")

    with TemporaryDirectory() as workspace:
        event = dict(hook_event_name="UserPromptSubmit", session_id="installation-check",
                     cwd=workspace, prompt="Build a banana game for my own amusement.")
        response = subprocess.check_output(
            [sys.executable, installed / "hooks/dispatch.py"], text=True, input=json.dumps(event),
            cwd=workspace, env={**os.environ, "PLUGIN_DATA": workspace, "PLUGIN_ROOT": str(installed)},
        )
        decision = json.loads(response)
        if decision != {}:
            sys.exit(decision.get("reason", "The personal test request was not approved."))
    print(f"Installed files match and Jev approved a test submission. Plugin root: {installed}")


if __name__ == "__main__":
    main()
