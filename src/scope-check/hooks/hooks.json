{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Checking work scope",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Saving work-item context",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
