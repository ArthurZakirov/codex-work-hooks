{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Recording patch for review",
            "timeout": 300
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Checking for edits to review",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
