{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Remembering the request for review",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/dispatch.py\"",
            "statusMessage": "Reviewing experience, standards and correctness",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
