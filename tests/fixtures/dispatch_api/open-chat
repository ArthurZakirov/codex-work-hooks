#!/bin/bash
set -eu
fixture=$(cd "$(dirname "$0")" && pwd)
source "$fixture/prepare-mac.sh"
case ${WORK_HOOKS_MODEL:-} in
  *[Ll][Uu][Nn][Aa]*) echo "WORK_HOOKS_MODEL cannot select a Luna model." >&2; exit 2 ;;
esac
prepare_tools
export WORK_HOOKS_CLASSIFIER="${WORK_HOOKS_CLASSIFIER:-codex}"
if [[ "$WORK_HOOKS_CLASSIFIER" == jev ]]; then
  prepare_jev
fi
checkout=$(cd "$fixture/../../.." && pwd)
experiment=$(mktemp -d "${TMPDIR:-/tmp}/dispatch-eval-XXXXXX")
login_home=${WORK_HOOKS_TEST_AUTH_HOME:-${CODEX_HOME:-$HOME/.codex}}
export CODEX_HOME="$experiment/codex" HOME="$experiment/home"
export WORK_HOOKS_DEMO_TICKET="$fixture/OPS-17.md"

mkdir -p "$CODEX_HOME" "$HOME" "$experiment/workspace"
cd "$experiment/workspace"
workspace=$(pwd -P)
cp "$fixture/service.py" .
git init -q
if [[ -f "$login_home/auth.json" ]]; then
  ln -s "$login_home/auth.json" "$CODEX_HOME/auth.json"
fi
python3 - "$workspace" "$CODEX_HOME/config.toml" <<'PY'
import json
from pathlib import Path
import sys

Path(sys.argv[2]).write_text(f'[projects.{json.dumps(sys.argv[1])}]\ntrust_level = "trusted"\n')
PY
if ! codex login status >/dev/null 2>&1; then
  [[ -t 0 ]] || { echo "The isolated trial needs Codex login. Start interactively once or supply WORK_HOOKS_TEST_AUTH_HOME." >&2; exit 1; }
  codex login
fi
codex plugin marketplace add "$checkout" >/dev/null
install=$(codex plugin add scope-check@work-hooks --json)
probe() {
  export PLUGIN_ROOT=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["installedPath"])' <<< "$install")
  export PLUGIN_DATA="$experiment/check-data"
  response=$(printf '%s' '{"hook_event_name":"UserPromptSubmit","session_id":"launch-check","prompt":"Build a banana game for my own amusement."}' | python3 "$PLUGIN_ROOT/hooks/dispatch.py")
  [[ "$response" == '{}' ]] || { echo "$response" >&2; return 1; }
}
case ${1:-} in
  --check|--check-submit) probe "$1"; exit ;;
  "") probe --check-submit ;;
  *) echo "Usage: open-chat [--check|--check-submit]" >&2; exit 2 ;;
esac
unset PLUGIN_ROOT PLUGIN_DATA
exec codex --no-daemon --dangerously-bypass-hook-trust -s workspace-write \
  -m "${WORK_HOOKS_MODEL:-gpt-6.1-terra}" -c 'model_reasoning_effort="low"'
