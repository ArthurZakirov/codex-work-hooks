#!/bin/bash
set -eu
fixture=$(cd "$(dirname "$0")" && pwd)
checkout=$(cd "$fixture/../../.." && pwd)
experiment=$(mktemp -d "${TMPDIR:-/tmp}/dispatch-eval-XXXXXX")
login_home=${WORK_HOOKS_TEST_AUTH_HOME:-${CODEX_HOME:-$HOME/.codex}}
export CODEX_HOME="$experiment/codex" HOME="$experiment/home"
export WORK_HOOKS_DEMO_TICKET="$fixture/OPS-17.md"

mkdir -p "$CODEX_HOME" "$HOME" "$experiment/workspace"
cd "$experiment/workspace"
workspace=$(pwd -P)
cp "$fixture/service.py" .
git init -q
if [[ -f "$login_home/auth.json" ]]; then
  ln -s "$login_home/auth.json" "$CODEX_HOME/auth.json"
fi
python3 - "$workspace" "$CODEX_HOME/config.toml" <<'PY'
import json
from pathlib import Path
import sys

Path(sys.argv[2]).write_text(f'[projects.{json.dumps(sys.argv[1])}]\ntrust_level = "trusted"\n')
PY
codex plugin marketplace add "$checkout" >/dev/null
install=$(codex plugin add work-hooks@work-hooks --json)
if [[ ${1:-} == --check || ${1:-} == --check-submit ]]; then
  PLUGIN_ROOT=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["installedPath"])' <<< "$install")
  export PLUGIN_ROOT
  export PLUGIN_DATA="$experiment/check-data"
  python3 - "$workspace" "$1" <<'PYTHON'
import json
import os
from pathlib import Path
import subprocess
import sys

program = Path(os.environ["PLUGIN_ROOT"]) / "hooks/dispatch.py"
print("Classifier:", os.getenv("WORK_HOOKS_CLASSIFIER", "jev"), flush=True)
for event in (
    {"hook_event_name": "UserPromptSubmit", "prompt": "Build a banana game for my own amusement."},
    {"hook_event_name": "Stop", "stop_hook_active": False},
):
    if event["hook_event_name"] == "Stop" and sys.argv[2] == "--check-submit":
        break
    event.update(session_id="synthetic-launch-check", cwd=sys.argv[1])
    result = subprocess.run([sys.executable, program], input=json.dumps(event),
                            text=True, capture_output=True, check=True)
    response = json.loads(result.stdout)
    if event["hook_event_name"] == "UserPromptSubmit" and response != {}:
        sys.exit(response.get("reason", "Synthetic personal request was misclassified."))
    if event["hook_event_name"] == "Stop" and not list(Path(os.environ["PLUGIN_DATA"]).rglob("review.md")):
        sys.exit(response.get("reason", "No review report was produced."))
    print(event["hook_event_name"], "passed")
PYTHON
  exit
fi
exec codex --no-daemon --dangerously-bypass-hook-trust -s workspace-write \
  -m "${WORK_HOOKS_MODEL:-gpt-6-luna}" -c 'model_reasoning_effort="low"'
